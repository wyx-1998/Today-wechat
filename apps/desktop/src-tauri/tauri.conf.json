{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wechat-today",
  "version": "0.1.0",
  "identifier": "cn.wechat-today.desktop",
  "build": {
    "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "wechat-today", "width": 1240, "height": 820, "minWidth": 900, "minHeight": 640 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true, "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/reader"],
    "macOS": { "minimumSystemVersion": "14.0" }
  }
}
